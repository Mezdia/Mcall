<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="oval">
            <size android:width="@dimen/switch_thumb" android:height="@dimen/switch_thumb" />
            <solid android:color="@color/thumb_white" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="20dp" android:height="20dp" />
            <solid android:color="@color/thumb_white" />
            <stroke android:width="1dp" android:color="@color/switch_thumb_stroke" />
        </shape>
    </item>
</selector>
