<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:orientation="vertical">

    <!-- One UI collapsed app bar: 64dp, 21sp start title, quick auto-record switch, settings. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_recordings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/appbar_title"
            android:fontFamily="@font/vazirmatn_medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/label_auto"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_summary"
            android:fontFamily="@font/vazirmatn_regular" />

        <Switch
            android:id="@+id/sw_auto"
            style="@style/Widget.Mcall.Switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/sw_auto" />

        <ImageButton
            android:id="@+id/btn_settings"
            style="@style/Widget.Mcall.IconButton"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/title_settings" />
    </LinearLayout>

    <!-- Compact service control: one row instead of a tall card. -->
    <LinearLayout
        android:id="@+id/control_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/control_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_status_dot"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/service_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/vazirmatn_regular" />

        <Button
            android:id="@+id/btn_toggle_service"
            style="@style/Widget.Mcall.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="14sp"
            android:text="@string/btn_start" />
    </LinearLayout>

    <!-- One-line password banner, removed once a password exists. -->
    <LinearLayout
        android:id="@+id/notice_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_lock"
            android:tint="@color/fn_orange"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/notice_password_short"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/vazirmatn_regular" />

        <Button
            android:id="@+id/btn_set_password"
            style="@style/Widget.Mcall.Button.Neutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="14sp"
            android:text="@string/btn_set_password" />
    </LinearLayout>

    <TextView
        android:id="@+id/list_subheader"
        style="@style/Text.Mcall.Subheader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sub_recordings" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:divider="@drawable/divider_inset"
            android:dividerHeight="@dimen/divider_height"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbarStyle="outsideOverlay" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_wave"
                android:tint="@color/text_disabled"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/empty_list"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_body"
                android:fontFamily="@font/vazirmatn_regular" />
        </LinearLayout>
    </FrameLayout>

    <include
        android:id="@+id/player_bar"
        layout="@layout/bar_player_mini"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
