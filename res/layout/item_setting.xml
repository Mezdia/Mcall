<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="@dimen/pref_icon"
        android:layout_height="@dimen/pref_icon"
        android:layout_marginEnd="16dp"
        android:padding="6dp"
        android:tint="@color/accent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            style="@style/Text.Mcall.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/row_summary"
            style="@style/Text.Mcall.RowSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <Switch
        android:id="@+id/row_switch"
        style="@style/Widget.Mcall.Switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/row_chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_chevron"
        android:tint="@color/text_disabled"
        android:visibility="gone"
        android:contentDescription="@null" />
</merge>
