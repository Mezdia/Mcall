<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sec_password"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_dialog_title"
        android:fontFamily="@font/vazirmatn_medium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pw_dialog_body"
        android:textColor="@color/text_on_card_secondary"
        android:textSize="@dimen/text_dialog_body"
        android:fontFamily="@font/vazirmatn_regular"
        android:lineSpacingExtra="4sp" />

    <FrameLayout
        android:id="@+id/field_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <EditText
            android:id="@+id/pw_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_current_pw"
            android:inputType="textPassword"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/vazirmatn_regular"
            android:paddingEnd="44dp"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/eye_current"
            style="@style/Widget.Mcall.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_visibility"
            android:tint="@color/text_tertiary"
            android:contentDescription="@string/show_password" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/pw_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_new_pw"
            android:inputType="textPassword"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/vazirmatn_regular"
            android:paddingEnd="44dp"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/eye_new"
            style="@style/Widget.Mcall.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_visibility"
            android:tint="@color/text_tertiary"
            android:contentDescription="@string/show_password" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/pw_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_repeat_pw"
            android:inputType="textPassword"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/vazirmatn_regular"
            android:paddingEnd="44dp"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/eye_confirm"
            style="@style/Widget.Mcall.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_visibility"
            android:tint="@color/text_tertiary"
            android:contentDescription="@string/show_password" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/Widget.Mcall.DialogButton"
            android:text="@string/btn_cancel" />

        <Button
            android:id="@+id/btn_save"
            style="@style/Widget.Mcall.DialogButton"
            android:text="@string/btn_save" />
    </LinearLayout>
</LinearLayout>
