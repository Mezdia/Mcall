<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <TextView
        android:id="@+id/dlg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_dialog_title"
        android:fontFamily="@font/vazirmatn_medium" />

    <TextView
        android:id="@+id/dlg_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_on_card_secondary"
        android:textSize="@dimen/text_dialog_body"
        android:lineSpacingExtra="4sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_negative"
            style="@style/Widget.Mcall.DialogButton"
            android:text="@string/btn_cancel" />

        <Button
            android:id="@+id/btn_positive"
            style="@style/Widget.Mcall.DialogButton"
            android:text="@string/btn_delete" />
    </LinearLayout>
</LinearLayout>
